# 构建产物
bin
frontend/dist
.task

# 依赖
frontend/node_modules
.pnpm-store

# 本地构建缓存（Go / 测试）
.gocache
.gotmp
.tmp

# 黄金值生成脚本的 Python 缓存
__pycache__
*.pyc

# 组合库（运行时数据，与 config.json 同目录的那个才是真的）
# 这条是为了挡住测试写错路径时落在包目录里的残留
portfolio.db

# 运行期缓存（「按股票」日线派生缓存；正常情况下与 config.json 同目录）
cache/

# 运行日志
debug.log
log.txt

# 安装包相关
build/linux/appimage/build
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# Android 构建产物（gradle 生成，不该进仓库）
build/android/.gradle
build/android/build
build/android/app/build
build/android/local.properties

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
