<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="freestock.exe"
        Arguments=""
        InstallLocation="C:\Program Files\FreeStock\FreeStock">
    </Installer>
    <PackageInformation
        PackageName="FreeStock"
        PackageDisplayName="FreeStock"
        PublisherName="CN=FreeStock"
        PublisherDisplayName="FreeStock"
        Version="0.1.0.0"
        PackageDescription="A股本地量化数据工具">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.freestock.app"
                Description="A股本地量化数据工具"
                DisplayName="FreeStock"
                ExecutableName="freestock.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>FreeStock</DisplayName>
            <PublisherDisplayName>FreeStock</PublisherDisplayName>
            <Description>A股本地量化数据工具</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="freestock.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
